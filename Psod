	mainFrame.Visible = not mainFrame.Visible
end)

saveBtn.MouseButton1Click:Connect(function()
	local folderInputText = ensureFolderHierarchy(folderInput.Text)
	local poseInputText = poseInput.Text ~= "" and poseInput.Text or ("Pose_" .. tostring(tick()):sub(5, 8))

	local char = LocalPlayer.Character
	if not char then return end

	local poseData = extractPoseData(char)
	if poseData then
		SavedFolders[folderInputText][poseInputText] = poseData

		poseInput.Text = ""
		savePosesToFile()
		refreshList()
	end
end)

