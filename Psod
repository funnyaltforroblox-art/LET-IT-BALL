local function updateScrollListCanvasSize(expandIfNearBottom)
	local contentHeight = listLayout.AbsoluteContentSize.Y + listPadding.PaddingTop.Offset + listPadding.PaddingBottom.Offset + 4
	local minHeight = math.max(contentHeight + extraInfiniteRunway, scrollList.AbsoluteSize.Y + extraInfiniteRunway)
