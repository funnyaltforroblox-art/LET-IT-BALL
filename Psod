local function isSpawnedPoseObject(instance)
	for _, entry in ipairs(spawnedPoseObjects) do
		if typeof(entry) == "Instance" and (instance == entry or instance:IsDescendantOf(entry)) then
			return true
		elseif type(entry) == "table" and typeof(entry.Model) == "Instance" and (instance == entry.Model or instance:IsDescendantOf(entry.Model)) then
			return true
		end
	end
	return false
end

local function scanAttachedPlayerAccessories(character)
	if not character then return {} end
	local anchorPart = getStaticAnchorPart(character)
	if not anchorPart then return {} end

	local anchorCF = anchorPart.CFrame
	local collected = {}
	local partCounter = 0

	for accIndex, child in ipairs(character:GetChildren()) do
		if child:IsA("Accessory") and not isSpawnedPoseObject(child) then
			extractedDuplicateCounter = extractedDuplicateCounter + 1
			local uniqueId = string.format("%s__dup_%d_%d", tostring(child.Name), accIndex, extractedDuplicateCounter)

			local handle = child:FindFirstChild("Handle") or child:FindFirstChildWhichIsA("BasePart", true)
			local partsMap = {}
			local idx = 0

			for _, desc in ipairs(child:GetDescendants()) do
				if desc:IsA("BasePart") then
					idx = idx + 1
					partCounter = partCounter + 1
					local partKey = string.format("%s__p%d_%d", desc.Name ~= "" and desc.Name or "Part", partCounter, idx)
					local isQV = isQualityVisualPart(desc.Name)

					local specialMesh = desc:FindFirstChildWhichIsA("SpecialMesh")
					local meshId = ""
					local textureId = ""
					local hasMeshScale = false
					local meshScaleX, meshScaleY, meshScaleZ = 1, 1, 1

					if specialMesh then
						meshId = normalizeAssetId(specialMesh.MeshId)
						textureId = normalizeAssetId(specialMesh.TextureId)
						if specialMesh.Scale then
							hasMeshScale = true
							meshScaleX = specialMesh.Scale.X
							meshScaleY = specialMesh.Scale.Y
							meshScaleZ = specialMesh.Scale.Z
						end
					elseif desc:IsA("MeshPart") then
						meshId = normalizeAssetId(desc.MeshId)
						textureId = normalizeAssetId(desc.TextureID)
					end

					if isQV then
						hasMeshScale = true
						meshScaleX, meshScaleY, meshScaleZ = 0, 0, 0
					end

					local decalTextures = {}
					for _, sub in ipairs(desc:GetChildren()) do
						if sub:IsA("Decal") or sub:IsA("Texture") then
							table.insert(decalTextures, {
								ClassName = sub.ClassName,
								Name = sub.Name,
								Texture = normalizeAssetId(sub.Texture),
								Face = tostring(sub.Face),
								Transparency = isQV and 0 or sub.Transparency
							})
						end
					end

					local cR, cG, cB = getPartColorRGB(desc)
					local matStr = string.gsub(tostring(desc.Material), "^Enum%.Material%.", "")

					partsMap[partKey] = {
						Key = partKey,
						Name = desc.Name,
						IsHandle = (handle ~= nil and desc == handle),
						RootRelCFrame = anchorCF:ToObjectSpace(desc.CFrame),
						SizeX = isQV and 0 or desc.Size.X,
						SizeY = isQV and 0 or desc.Size.Y,
						SizeZ = isQV and 0 or desc.Size.Z,
						HasMeshScale = hasMeshScale,
						MeshScaleX = meshScaleX,
						MeshScaleY = meshScaleY,
						MeshScaleZ = meshScaleZ,
						MeshId = meshId,
						TextureId = textureId,
						ColorR = cR,
						ColorG = cG,
						ColorB = cB,
						Material = matStr,
						Transparency = isQV and 0 or desc.Transparency,
						Reflectance = desc.Reflectance,
						DecalTextures = decalTextures
					}
				end
			end

			if next(partsMap) ~= nil then
				table.insert(collected, {
					UniqueId = uniqueId,
					Name = child.Name,
					Parts = partsMap
				})
			end
		end
	end

	return collected
end

local function clearSpawnedPoseObjects()
	if activeObjectsFollowLoop then
		activeObjectsFollowLoop:Disconnect()
		activeObjectsFollowLoop = nil
	end
	for _, entry in ipairs(spawnedPoseObjects) do
		if typeof(entry) == "Instance" then
			entry:Destroy()
		elseif type(entry) == "table" and typeof(entry.Model) == "Instance" then
			entry.Model:Destroy()
		end
	end
	spawnedPoseObjects = {}
end

local function applyStaticPartForm(part, pInfo, anchorCF)
	local isQV = isQualityVisualPart(pInfo.Name or part.Name)
	local partSize = isQV and Vector3.new(0, 0, 0) or Vector3.new(pInfo.SizeX or 1, pInfo.SizeY or 1, pInfo.SizeZ or 1)
	part.Size = partSize
	part.CFrame = anchorCF * (pInfo.RootRelCFrame or CFrame.identity)
	if isQV then
		part.Transparency = 0
	end

	local specialMesh = part:FindFirstChildWhichIsA("SpecialMesh")
	if specialMesh and (isQV or pInfo.HasMeshScale) then
		specialMesh.Scale = isQV and Vector3.new(0, 0, 0) or Vector3.new(pInfo.MeshScaleX or 1, pInfo.MeshScaleY or 1, pInfo.MeshScaleZ or 1)
	end
end

local function spawnIncludedObjects(character, includedObjects)
	clearSpawnedPoseObjects()
	if type(includedObjects) ~= "table" or #includedObjects == 0 then return end

	local anchorPart = getStaticAnchorPart(character)
	local anchorCF = anchorPart and anchorPart.CFrame or CFrame.identity
	local trackedParts = {}

	for idx, objEntry in ipairs(includedObjects) do
		local container = Instance.new("Model")
		container.Name = string.format("StaticAcc_%s_%d", tostring(objEntry.Name or "Accessory"), idx)

		for _, pInfo in pairs(objEntry.Parts or {}) do
			local isQV = isQualityVisualPart(pInfo.Name)
			local part = Instance.new("Part")
			part.Name = pInfo.Name or "Part"
			part.Anchored = true
			part.CanCollide = false
			part.Massless = true
			part.Transparency = isQV and 0 or (pInfo.Transparency or 0)
			part.Reflectance = pInfo.Reflectance or 0

			local matEnum = Enum.Material[tostring(pInfo.Material or "Plastic")]
			part.Material = matEnum or Enum.Material.Plastic
			applyPartColorRGB(part, pInfo.ColorR, pInfo.ColorG, pInfo.ColorB)

			local meshId = normalizeAssetId(pInfo.MeshId)
			local textureId = normalizeAssetId(pInfo.TextureId)

			if meshId ~= "" or textureId ~= "" or pInfo.HasMeshScale or isQV then
				local sm = Instance.new("SpecialMesh")
				sm.MeshType = meshId ~= "" and Enum.MeshType.FileMesh or Enum.MeshType.Brick
				if meshId ~= "" then sm.MeshId = meshId end
				if textureId ~= "" then sm.TextureId = textureId end
				if isQV then
					sm.Scale = Vector3.new(0, 0, 0)
				elseif pInfo.HasMeshScale then
					sm.Scale = Vector3.new(pInfo.MeshScaleX or 1, pInfo.MeshScaleY or 1, pInfo.MeshScaleZ or 1)
				end
				sm.Parent = part
			end

			for _, decInfo in ipairs(pInfo.DecalTextures or {}) do
				local decClass = (decInfo.ClassName == "Texture") and "Texture" or "Decal"
				local dec = Instance.new(decClass)
				dec.Name = decInfo.Name or decClass
				dec.Texture = normalizeAssetId(decInfo.Texture)
				dec.Transparency = isQV and 0 or (decInfo.Transparency or 0)
				local faceEnum = Enum.NormalId[tostring(decInfo.Face or "Front")]
				if faceEnum then dec.Face = faceEnum end
				dec.Parent = part
			end

			applyStaticPartForm(part, pInfo, anchorCF)
			part.Parent = container
			table.insert(trackedParts, {
				Part = part,
				Info = pInfo
			})
		end

		container.Parent = workspace
		table.insert(spawnedPoseObjects, {
			Model = container
		})
	end

	activeObjectsFollowLoop = RunService.Stepped:Connect(function()
		if not character or not character.Parent then
			clearSpawnedPoseObjects()
			return
		end
		local currentAnchor = getStaticAnchorPart(character)
		if not currentAnchor then return end
		local currentAnchorCF = currentAnchor.CFrame

		for i = #trackedParts, 1, -1 do
			local item = trackedParts[i]
			if item.Part and item.Part.Parent then
				applyStaticPartForm(item.Part, item.Info, currentAnchorCF)
			else
				table.remove(trackedParts, i)
			end
		end
	end)
end

----------------------------------------------------
-- POSE & ANIMATION HELPER FUNCTIONS
----------------------------------------------------

local function unloadPose(character)
	if activePoseLoop then
		activePoseLoop:Disconnect()
		activePoseLoop = nil
	end
	clearSpawnedPoseObjects()
	currentLoadedPoseIdentifier = nil
	currentLoadedPoseEntry = nil

	if character then
		local animateScript = character:FindFirstChild("Animate")
		if animateScript and animateScript:IsA("LocalScript") then
			animateScript.Disabled = false
		end
	end
end

local function freezeAnimations(character, exclusions)
	local animateScript = character:FindFirstChild("Animate")
	if animateScript and animateScript:IsA("LocalScript") then
		if next(exclusions) == nil then
			animateScript.Disabled = true
		end
	end
end

local function extractPoseData(character)
	local torso = character:FindFirstChild("Torso")
	local humanRoot = character:FindFirstChild("HumanoidRootPart")
	if not torso or not humanRoot then return nil end

	local joints = {}

	for limbName, jointName in pairs(R6_LIMB_MAP) do
		local limb = character:FindFirstChild(limbName)
		local parentPart = (limbName == "HumanoidRootPart") and humanRoot or torso
		local joint = parentPart and (parentPart:FindFirstChild(jointName) or torso:FindFirstChild(jointName))

		if limb and joint and joint:IsA("Motor6D") then
			local relativeCFrame
			if jointName == "RootJoint" then
				relativeCFrame = humanRoot.CFrame:ToObjectSpace(torso.CFrame)
			else
				relativeCFrame = torso.CFrame:ToObjectSpace(limb.CFrame)
			end
			joints[jointName] = relativeCFrame
		end
	end

	local capturedObjects = includeObjectsEnabled and scanAttachedPlayerAccessories(character) or {}

	return {
		Joints = joints,
		Exclusions = {},
		IncludedObjects = capturedObjects,
		Sounds = {},
		AnimOrder = nil,
		Trigger = { Enabled = false, MinHP = 0, MaxHP = 100 }
	}
end

local function applyPoseData(character, poseEntry, poseIdentifier, forceApply)
	local torso = character:FindFirstChild("Torso")
	local humanRoot = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not torso or not humanRoot or not humanoid then return end

	if not forceApply and currentLoadedPoseIdentifier == poseIdentifier then
		unloadPose(character)
		return
	end

	local trigger = poseEntry.Trigger
	if trigger and trigger.Enabled then
		local hpPercent = (humanoid.Health / humanoid.MaxHealth) * 100
		if hpPercent < trigger.MinHP or hpPercent > trigger.MaxHP then
			return
		end
	end

	if activePoseLoop then
		activePoseLoop:Disconnect()
		activePoseLoop = nil
	end

	currentLoadedPoseIdentifier = poseIdentifier
	currentLoadedPoseEntry = poseEntry

	local poseData = poseEntry.Joints
	local exclusions = poseEntry.Exclusions or {}

	spawnIncludedObjects(character, poseEntry.IncludedObjects)
	freezeAnimations(character, exclusions)

	activePoseLoop = RunService.Stepped:Connect(function()
		if not character or not character.Parent or not humanoid or humanoid.Health <= 0 then
			unloadPose(character)
			return
		end

		for jointName, relativeCFrame in pairs(poseData) do
			if not exclusions[jointName] then
				local joint = torso:FindFirstChild(jointName) or humanRoot:FindFirstChild(jointName)
				if joint and joint:IsA("Motor6D") then
					joint.Transform = joint.C0:Inverse() * relativeCFrame * joint.C1
				end
			end
		end
	end)
end

local function movePoseToFolder(sourceFolderPath, poseName, targetFolderRaw)
	if not SavedFolders[sourceFolderPath] or not SavedFolders[sourceFolderPath][poseName] then
		return false
	end

	local targetFolderPath = ensureFolderHierarchy(targetFolderRaw)
	if targetFolderPath == sourceFolderPath then
		return true
	end

	local entry = SavedFolders[sourceFolderPath][poseName]
	local finalPoseName = poseName

	if SavedFolders[targetFolderPath][finalPoseName] then
		local suffix = 2
		while SavedFolders[targetFolderPath][poseName .. "_" .. tostring(suffix)] do
			suffix = suffix + 1
		end
		finalPoseName = poseName .. "_" .. tostring(suffix)
	end

	SavedFolders[targetFolderPath][finalPoseName] = entry
	SavedFolders[sourceFolderPath][poseName] = nil

	local oldId = sourceFolderPath .. "/" .. poseName
	local newId = targetFolderPath .. "/" .. finalPoseName
	if currentLoadedPoseIdentifier == oldId then
		currentLoadedPoseIdentifier = newId
	end

	savePosesToFile()
	if refreshList then
		refreshList()
	end
	return true
end

----------------------------------------------------
-- ORDERED POSE ANIMATION RUNNER (LOOPS TO HIGHEST NUMBER)
----------------------------------------------------

local function stopAnimationSequence(resetPose)
	activeAnimationToken = activeAnimationToken + 1
	activeAnimationPlaying = false
	stopAnimationSound()
	if resetPose and LocalPlayer.Character then
		unloadPose(LocalPlayer.Character)
	end
end

local function getOrderedPoseSteps()
	local steps = {}
	local highestOrder = 0

	for folderName, poses in pairs(SavedFolders) do
		for poseName, poseEntry in pairs(poses) do
			local orderNum = tonumber(poseEntry.AnimOrder)
			if orderNum and orderNum >= 1 then
				local intOrder = math.floor(orderNum)
				if intOrder > highestOrder then
					highestOrder = intOrder
				end
				table.insert(steps, {
					Order = intOrder,
					FolderName = folderName,
					PoseName = poseName,
					PoseEntry = poseEntry,
					Identifier = folderName .. "/" .. poseName
				})
			end
		end
	end

	table.sort(steps, function(a, b)
		if a.Order ~= b.Order then
			return a.Order < b.Order
		end
		if a.FolderName ~= b.FolderName then
			return a.FolderName < b.FolderName
		end
		return a.PoseName < b.PoseName
	end)

	return steps, highestOrder
end

local function startAnimationSequence()
	stopAnimationSequence(false)
	refreshSoundFolderAssets()
	local steps, highestOrder = getOrderedPoseSteps()
	if #steps == 0 or highestOrder < 1 then return end

	activeAnimationToken = activeAnimationToken + 1
	local myToken = activeAnimationToken
	activeAnimationPlaying = true

	task.spawn(function()
		while animationModeEnabled and activeAnimationToken == myToken do
			local currentSteps, currentMaxOrder = getOrderedPoseSteps()
			if #currentSteps == 0 or currentMaxOrder < 1 then
				break
			end

			for _, step in ipairs(currentSteps) do
				if not animationModeEnabled or activeAnimationToken ~= myToken then
					return
				end

				local char = LocalPlayer.Character
				if not char or not char.Parent then
					break
				end

				applyPoseData(char, step.PoseEntry, step.Identifier, true)
				playRandomPoseAnimationSound(step.PoseEntry)
				if refreshList then
					refreshList()
				end

				local waitTime = math.max(0, tonumber(animationDelaySeconds) or 0)
				local elapsed = 0
				while elapsed < waitTime do
					if not animationModeEnabled or activeAnimationToken ~= myToken then
						return
					end
					local dt = task.wait(0.05)
					elapsed = elapsed + dt
				end
			end
		end

		if activeAnimationToken == myToken then
			activeAnimationPlaying = false
			stopAnimationSound()
			if LocalPlayer.Character then
				unloadPose(LocalPlayer.Character)
			end
			if refreshList then
				refreshList()
			end
		end
	end)
end

----------------------------------------------------
-- BACKGROUND AUTOMATIC HP TRIGGER SCANNER
----------------------------------------------------
RunService.Stepped:Connect(function()
	if activeAnimationPlaying then return end

	local char = LocalPlayer.Character
	if not char then return end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end

	local hpPercent = (humanoid.Health / humanoid.MaxHealth) * 100
	local targetPoseToLoad = nil
	local targetPoseId = nil

	for folderName, poses in pairs(SavedFolders) do
		for poseName, poseEntry in pairs(poses) do
			local trig = poseEntry.Trigger
			if trig and trig.Enabled then
				if hpPercent >= trig.MinHP and hpPercent <= trig.MaxHP then
					targetPoseToLoad = poseEntry
					targetPoseId = folderName .. "/" .. poseName
					break
				end
			end
		end
		if targetPoseToLoad then break end
	end

	if targetPoseToLoad then
		if currentLoadedPoseIdentifier ~= targetPoseId then
			applyPoseData(char, targetPoseToLoad, targetPoseId)
		end
	else
		if currentLoadedPoseIdentifier then
			local foundFolder, foundName = currentLoadedPoseIdentifier:match("^(.+)/([^/]+)$")
			if foundFolder and SavedFolders[foundFolder] and SavedFolders[foundFolder][foundName] then
				local activeEntry = SavedFolders[foundFolder][foundName]
				if activeEntry.Trigger and activeEntry.Trigger.Enabled then
					if hpPercent < activeEntry.Trigger.MinHP or hpPercent > activeEntry.Trigger.MaxHP then
						unloadPose(char)
					end
				end
			end
		end
	end
end)

