----------------------------------------------------
-- FILE SYSTEM (DELTA WORKSPACE STORAGE)
----------------------------------------------------

local function serializeCFrame(cf)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return {x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22}
end

local function deserializeCFrame(tbl)
	if not tbl then return CFrame.identity end
	return CFrame.new(unpack(tbl))
end

local function savePosesToFile()
	if not writefile then return end
	
	pcall(function()
		if not isfolder(FOLDER_NAME) then
			makefolder(FOLDER_NAME)
		end
		
		local serializableData = {}
		for folderName, poses in pairs(SavedFolders) do
			serializableData[folderName] = {}
			for poseName, poseData in pairs(poses) do
				serializableData[folderName][poseName] = {
					Joints = {},
					Exclusions = poseData.Exclusions or {},
					Trigger = poseData.Trigger or { Enabled = false, MinHP = 0, MaxHP = 100 }
				}
				for jointName, cf in pairs(poseData.Joints) do
					serializableData[folderName][poseName].Joints[jointName] = serializeCFrame(cf)
				end
			end
		end
		
		writefile(FILE_NAME, HttpService:JSONEncode(serializableData))
	end)
end

local function loadPosesFromFile()
	if not readfile or not isfile or not isfile(FILE_NAME) then return end
	
	pcall(function()
		local content = readfile(FILE_NAME)
		local decoded = HttpService:JSONDecode(content)
		if decoded then
			SavedFolders = {}
			for folderName, poses in pairs(decoded) do
				SavedFolders[folderName] = {}
				for poseName, poseData in pairs(poses) do
					SavedFolders[folderName][poseName] = {
						Joints = {},
						Exclusions = poseData.Exclusions or {},
						Trigger = poseData.Trigger or { Enabled = false, MinHP = 0, MaxHP = 100 }
					}
					local rawJoints = poseData.Joints or poseData
					for jointName, cfTbl in pairs(rawJoints) do
						if jointName ~= "Exclusions" and jointName ~= "Trigger" then
							SavedFolders[folderName][poseName].Joints[jointName] = deserializeCFrame(cfTbl)
						end
					end
				end
			end
		end
	end)
end

----------------------------------------------------
-- POSE & ANIMATION HELPER FUNCTIONS
----------------------------------------------------

local function unloadPose(character)
	if activePoseLoop then
		activePoseLoop:Disconnect()
		activePoseLoop = nil
	end
	currentLoadedPoseIdentifier = nil

	local animateScript = character:FindFirstChild("Animate")
	if animateScript and animateScript:IsA("LocalScript") then
		animateScript.Disabled = false
	end
end

local function freezeAnimations(character, exclusions)
	local animateScript = character:FindFirstChild("Animate")
	if animateScript and animateScript:IsA("LocalScript") then
		if next(exclusions) == nil then
			animateScript.Disabled = true
		end
	end
end

local function extractPoseData(character)
	local torso = character:FindFirstChild("Torso")
	if not torso then return nil end

	local joints = {}

	for limbName, jointName in pairs(R6_LIMB_MAP) do
		local limb = character:FindFirstChild(limbName)
		local parentPart = (limbName == "HumanoidRootPart") and character:FindFirstChild("HumanoidRootPart") or torso
		local joint = parentPart and (parentPart:FindFirstChild(jointName) or torso:FindFirstChild(jointName))

		if limb and joint and joint:IsA("Motor6D") then
			local relativeCFrame = torso.CFrame:ToObjectSpace(limb.CFrame)
			joints[jointName] = relativeCFrame
		end
	end

	return {
		Joints = joints,
		Exclusions = {},
		Trigger = { Enabled = false, MinHP = 0, MaxHP = 100 }
	}
end

local function applyPoseData(character, poseEntry, poseIdentifier)
	local torso = character:FindFirstChild("Torso")
	local humanRoot = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not torso or not humanRoot or not humanoid then return end

	-- Toggle off if clicking load on the already active pose
	if currentLoadedPoseIdentifier == poseIdentifier then
		unloadPose(character)
		return
	end

	-- Check HP Trigger Conditions before applying
	local trigger = poseEntry.Trigger
	if trigger and trigger.Enabled then
		local hpPercent = (humanoid.Health / humanoid.MaxHealth) * 100
		if hpPercent < trigger.MinHP then
			print("Pose trigger blocked: Health (" .. math.floor(hpPercent) .. "%) is below MinHP (" .. trigger.MinHP .. "%)")
			return
		end
	end

	if activePoseLoop then
		activePoseLoop:Disconnect()
		activePoseLoop = nil
	end

	currentLoadedPoseIdentifier = poseIdentifier

	local poseData = poseEntry.Joints
	local exclusions = poseEntry.Exclusions or {}

	freezeAnimations(character, exclusions)

	activePoseLoop = RunService.Stepped:Connect(function()
		if not character or not character.Parent or not humanoid or humanoid.Health <= 0 then
			unloadPose(character)
			return
		end

		-- Check MaxHP condition dynamically during run
		if trigger and trigger.Enabled then
			local hpPercent = (humanoid.Health / humanoid.MaxHealth) * 100
			if hpPercent < trigger.MaxHP then
				unloadPose(character)
				return
			end
		end

		for jointName, relativeCFrame in pairs(poseData) do
			if not exclusions[jointName] then
				local joint = torso:FindFirstChild(jointName) or humanRoot:FindFirstChild(jointName)
				if joint and joint:IsA("Motor6D") then
					joint.Transform = joint.C0:Inverse() * relativeCFrame * joint.C1
				end
			end
		end
	end)
end

----------------------------------------------------
-- DRAGGABLE GUI HELPER (Touch & Mouse Support)
----------------------------------------------------

local function makeDraggable(frame, dragHandle)
	dragHandle = dragHandle or frame
	local dragging = false
	local dragInput, dragStart, startPos

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	dragHandle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

