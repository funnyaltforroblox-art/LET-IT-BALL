----------------------------------------------------
-- SOUND FOLDER & PLAYBACK HELPERS
----------------------------------------------------

local function normalizeSoundAssetId(val)
	if not val then return "" end
	local str = tostring(val):match("^%s*(.-)%s*$")
	if str == "" then return "" end
	if string.match(str, "^%d+$") then
		return "rbxassetid://" .. str
	end
	return str
end

local function isSupportedAudioFileName(fileName)
	local lower = tostring(fileName or ""):lower()
	return lower:match("%.mp3$") ~= nil
		or lower:match("%.ogg$") ~= nil
		or lower:match("%.wav$") ~= nil
		or lower:match("%.flac$") ~= nil
		or lower:match("%.m4a$") ~= nil
end

local function getCustomAssetUrl(filePath)
	if getcustomasset then
		local ok, url = pcall(getcustomasset, filePath)
		if ok and type(url) == "string" and url ~= "" then
			return url
		end
	end
	if getsynasset then
		local ok, url = pcall(getsynasset, filePath)
		if ok and type(url) == "string" and url ~= "" then
			return url
		end
	end
	return nil
end

local function refreshSoundFolderAssets()
	local savedIds = {}
	if readfile and isfile and isfile(SOUND_CONFIG_FILE) then
		pcall(function()
			local parsed = HttpService:JSONDecode(readfile(SOUND_CONFIG_FILE))
			if type(parsed) == "table" and type(parsed.SoundIds) == "table" then
				savedIds = parsed.SoundIds
			end
		end)
	end

	pcall(function()
		if isfolder and not isfolder(FOLDER_NAME) then
			makefolder(FOLDER_NAME)
		end
		if isfolder and not isfolder(SOUNDS_FOLDER_NAME) then
			makefolder(SOUNDS_FOLDER_NAME)
		end
	end)

	local list = {}
	local seenKeys = {}

	if listfiles and isfolder and isfolder(SOUNDS_FOLDER_NAME) then
		pcall(function()
			for _, fullPath in ipairs(listfiles(SOUNDS_FOLDER_NAME)) do
				local cleanPath = tostring(fullPath):gsub("\\", "/")
				local fileName = cleanPath:match("([^/]+)$") or cleanPath
				if isSupportedAudioFileName(fileName) then
					local assetUrl = getCustomAssetUrl(cleanPath)
					if assetUrl then
						local key = "file:" .. cleanPath:lower()
						if not seenKeys[key] then
							seenKeys[key] = true
							table.insert(list, {
								Id = key,
								Label = "[File] " .. fileName,
								SoundId = assetUrl,
								SourceType = "file",
								RawValue = cleanPath
							})
						end
					end
				end
			end
		end)
	end

	for _, rawId in ipairs(savedIds) do
		local normalized = normalizeSoundAssetId(rawId)
		if normalized ~= "" then
			local key = "id:" .. normalized:lower()
			if not seenKeys[key] then
				seenKeys[key] = true
				table.insert(list, {
					Id = key,
					Label = "[ID] " .. tostring(rawId),
					SoundId = normalized,
					SourceType = "id",
					RawValue = tostring(rawId)
				})
			end
		end
	end

	table.sort(list, function(a, b)
		return a.Label:lower() < b.Label:lower()
	end)

	SoundFolderAssets = list
end

local function stopAnimationSound()
	if activeAnimSound then
		pcall(function()
			activeAnimSound:Stop()
			activeAnimSound:Destroy()
		end)
		activeAnimSound = nil
	end
end

local function playRandomPoseAnimationSound(poseEntry)
	stopAnimationSound()
	if type(poseEntry) ~= "table" or type(poseEntry.Sounds) ~= "table" or #poseEntry.Sounds == 0 then
		return
	end

	local validSounds = {}
	for _, sEntry in ipairs(poseEntry.Sounds) do
		if type(sEntry) == "table" then
			local sid = normalizeSoundAssetId(sEntry.SoundId or sEntry.RawValue)
			if sid ~= "" then
				table.insert(validSounds, sid)
			end
		elseif type(sEntry) == "string" then
			local sid = normalizeSoundAssetId(sEntry)
			if sid ~= "" then
				table.insert(validSounds, sid)
			end
		end
	end

	if #validSounds == 0 then return end

	local chosenSoundId = validSounds[math.random(1, #validSounds)]
	local snd = Instance.new("Sound")
	snd.Name = "R6PoseAnimSound"
	snd.SoundId = chosenSoundId
	snd.Volume = 1
	snd.Parent = SoundService
	activeAnimSound = snd

	pcall(function()
		snd:Play()
	end)
end

----------------------------------------------------
-- FOLDER & SUBFOLDER PATH HELPERS
----------------------------------------------------

local function normalizeFolderPath(rawPath)
	local cleaned = tostring(rawPath or ""):gsub("\\", "/")
	local parts = {}
	for segment in string.gmatch(cleaned, "[^/]+") do
		local trimmed = segment:match("^%s*(.-)%s*$")
		if trimmed ~= "" then
			table.insert(parts, trimmed)
		end
	end
	if #parts == 0 then
		return "Default"
	end
	return table.concat(parts, "/")
end

local function ensureFolderHierarchy(folderPath)
	local normalized = normalizeFolderPath(folderPath)
	local parts = {}
	for segment in string.gmatch(normalized, "[^/]+") do
		table.insert(parts, segment)
		local currentPath = table.concat(parts, "/")
		if not SavedFolders[currentPath] then
			SavedFolders[currentPath] = {}
		end
	end
	return normalized
end

local function collapseAllFolders()
	CollapsedFolders = {}
	for folderPath in pairs(SavedFolders) do
		CollapsedFolders[folderPath] = true
	end
end

local function getFolderDepth(folderPath)
	local depth = 0
	for _ in string.gmatch(folderPath, "/") do
		depth = depth + 1
	end
	return depth
end

local function getFolderDisplayName(folderPath)
	local leaf = folderPath:match("([^/]+)$")
	return leaf or folderPath
end

local function isAnyAncestorCollapsed(folderPath)
	local parts = {}
	for segment in string.gmatch(folderPath, "[^/]+") do
		table.insert(parts, segment)
	end
	for i = 1, #parts - 1 do
		local ancestorPath = table.concat(parts, "/", 1, i)
		if CollapsedFolders[ancestorPath] then
			return true
		end
	end
	return false
end

local function getSortedFolderPaths()
	local paths = {}
	for folderPath in pairs(SavedFolders) do
		table.insert(paths, folderPath)
	end
	table.sort(paths, function(a, b)
		if a == "Default" and b ~= "Default" then return true end
		if b == "Default" and a ~= "Default" then return false end
		return a:lower() < b:lower()
	end)
	return paths
end

local function deleteFolderAndSubfolders(targetFolderPath)
	if targetFolderPath == "Default" then return end
	local prefix = targetFolderPath .. "/"
	local toRemove = {}

	for folderPath in pairs(SavedFolders) do
		if folderPath == targetFolderPath or folderPath:sub(1, #prefix) == prefix then
			table.insert(toRemove, folderPath)
		end
	end

	for _, path in ipairs(toRemove) do
		if currentLoadedPoseIdentifier and currentLoadedPoseIdentifier:sub(1, #path + 1) == (path .. "/") then
			if LocalPlayer.Character then
				if activePoseLoop then
					activePoseLoop:Disconnect()
					activePoseLoop = nil
				end
				currentLoadedPoseIdentifier = nil
				currentLoadedPoseEntry = nil
			end
		end
		SavedFolders[path] = nil
		CollapsedFolders[path] = nil
	end
end

