local function isQualityVisualPart(partName)
	return tostring(partName or "") == QUALITY_VISUAL_PART_NAME
end

local function normalizeAssetId(val)
	if not val then return "" end
	local str = tostring(val)
	if str == "" then return "" end
	if string.match(str, "^%d+$") then
		return "rbxassetid://" .. str
	end
	return str
end

local function getPartColorRGB(part)
	if typeof(part) == "Instance" and part:IsA("BasePart") then
		local mesh = part:FindFirstChildWhichIsA("SpecialMesh")
		if mesh and mesh.VertexColor and mesh.VertexColor ~= Vector3.new(1, 1, 1) and mesh.VertexColor ~= Vector3.new(0, 0, 0) then
			return math.clamp(mesh.VertexColor.X, 0, 1), math.clamp(mesh.VertexColor.Y, 0, 1), math.clamp(mesh.VertexColor.Z, 0, 1)
		end
		return part.Color.R, part.Color.G, part.Color.B
	end
	return 1, 1, 1
end

local function applyPartColorRGB(part, r, g, b)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then return end
	local cr = math.clamp(tonumber(r) or 1, 0, 1)
	local cg = math.clamp(tonumber(g) or 1, 0, 1)
	local cb = math.clamp(tonumber(b) or 1, 0, 1)
	part.Color = Color3.new(cr, cg, cb)

	local mesh = part:FindFirstChildWhichIsA("SpecialMesh")
	if mesh and mesh.VertexColor and mesh.VertexColor ~= Vector3.new(1, 1, 1) then
		mesh.VertexColor = Vector3.new(cr, cg, cb)
	end
end

local function getStaticAnchorPart(character)
	if not character then return nil end
	return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
end

----------------------------------------------------
-- FILE SYSTEM (DELTA WORKSPACE STORAGE)
----------------------------------------------------

local function serializeCFrame(cf)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return {x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22}
end

local function deserializeCFrame(tbl)
	if not tbl then return CFrame.identity end
	return CFrame.new(unpack(tbl))
end

local function serializeIncludedObjects(objectsList)
	local out = {}
	if type(objectsList) ~= "table" then return out end
	for index, entry in ipairs(objectsList) do
		local partsSerialized = {}
		for partKey, pInfo in pairs(entry.Parts or {}) do
			local isQV = isQualityVisualPart(pInfo.Name or partKey)
			partsSerialized[partKey] = {
				Key = pInfo.Key or partKey,
				Name = pInfo.Name or partKey,
				IsHandle = pInfo.IsHandle or false,
				RootRelCFrame = serializeCFrame(pInfo.RootRelCFrame or CFrame.identity),
				Size = isQV and {0, 0, 0} or {pInfo.SizeX or 1, pInfo.SizeY or 1, pInfo.SizeZ or 1},
				MeshScale = isQV and {0, 0, 0} or (pInfo.HasMeshScale and {pInfo.MeshScaleX or 1, pInfo.MeshScaleY or 1, pInfo.MeshScaleZ or 1} or nil),
				MeshId = pInfo.MeshId or "",
				TextureId = pInfo.TextureId or "",
				Color = {pInfo.ColorR or 1, pInfo.ColorG or 1, pInfo.ColorB or 1},
				Material = pInfo.Material or "Plastic",
				Transparency = isQV and 0 or (pInfo.Transparency or 0),
				Reflectance = pInfo.Reflectance or 0,
				DecalTextures = pInfo.DecalTextures or {}
			}
		end
		table.insert(out, {
			UniqueId = entry.UniqueId or ("acc_" .. tostring(index)),
			Name = entry.Name or "Accessory",
			Parts = partsSerialized
		})
	end
	return out
end

local function deserializeIncludedObjects(rawList)
	local out = {}
	if type(rawList) ~= "table" then return out end
	for index, entry in ipairs(rawList) do
		if type(entry) == "table" then
			local partsDeserialized = {}
			for partKey, pInfo in pairs(entry.Parts or {}) do
				if type(pInfo) == "table" then
					local partName = pInfo.Name or partKey
					local isQV = isQualityVisualPart(partName)
					local sz = pInfo.Size or {1, 1, 1}
					local ms = pInfo.MeshScale
					local col = pInfo.Color or {1, 1, 1}
					partsDeserialized[partKey] = {
						Key = pInfo.Key or partKey,
						Name = partName,
						IsHandle = pInfo.IsHandle or false,
						RootRelCFrame = deserializeCFrame(pInfo.RootRelCFrame),
						SizeX = isQV and 0 or (sz[1] or 1),
						SizeY = isQV and 0 or (sz[2] or 1),
						SizeZ = isQV and 0 or (sz[3] or 1),
						HasMeshScale = isQV or (type(ms) == "table"),
						MeshScaleX = isQV and 0 or (type(ms) == "table" and (ms[1] or 1) or 1),
						MeshScaleY = isQV and 0 or (type(ms) == "table" and (ms[2] or 1) or 1),
						MeshScaleZ = isQV and 0 or (type(ms) == "table" and (ms[3] or 1) or 1),
						MeshId = pInfo.MeshId or "",
						TextureId = pInfo.TextureId or "",
						ColorR = col[1] or 1,
						ColorG = col[2] or 1,
						ColorB = col[3] or 1,
						Material = pInfo.Material or "Plastic",
						Transparency = isQV and 0 or (pInfo.Transparency or 0),
						Reflectance = pInfo.Reflectance or 0,
						DecalTextures = type(pInfo.DecalTextures) == "table" and pInfo.DecalTextures or {}
					}
				end
			end
			table.insert(out, {
				UniqueId = entry.UniqueId or ("acc_" .. tostring(index)),
				Name = entry.Name or "Accessory",
				Parts = partsDeserialized
			})
		end
	end
	return out
end

local function serializePoseSounds(soundsList)
	local out = {}
	if type(soundsList) ~= "table" then return out end
	for _, sEntry in ipairs(soundsList) do
		if type(sEntry) == "table" then
			table.insert(out, {
				Id = sEntry.Id or "",
				Label = sEntry.Label or "",
				SoundId = sEntry.SoundId or "",
				SourceType = sEntry.SourceType or "id",
				RawValue = sEntry.RawValue or sEntry.SoundId or ""
			})
		elseif type(sEntry) == "string" and sEntry ~= "" then
			table.insert(out, {
				Id = "id:" .. sEntry:lower(),
				Label = sEntry,
				SoundId = normalizeSoundAssetId(sEntry),
				SourceType = "id",
				RawValue = sEntry
			})
		end
	end
	return out
end

local function deserializePoseSounds(rawList)
	local out = {}
	if type(rawList) ~= "table" then return out end
	for _, sEntry in ipairs(rawList) do
		if type(sEntry) == "table" then
			local rawVal = sEntry.RawValue or sEntry.SoundId or ""
			local resolvedSoundId = sEntry.SoundId or ""
			if sEntry.SourceType == "file" and rawVal ~= "" then
				local fileUrl = getCustomAssetUrl(rawVal)
				if fileUrl then
					resolvedSoundId = fileUrl
				end
			elseif resolvedSoundId == "" and rawVal ~= "" then
				resolvedSoundId = normalizeSoundAssetId(rawVal)
			end
			if resolvedSoundId ~= "" then
				table.insert(out, {
					Id = sEntry.Id or (tostring(sEntry.SourceType or "id") .. ":" .. tostring(rawVal):lower()),
					Label = sEntry.Label or tostring(rawVal),
					SoundId = resolvedSoundId,
					SourceType = sEntry.SourceType or "id",
					RawValue = tostring(rawVal)
				})
			end
		elseif type(sEntry) == "string" and sEntry ~= "" then
			table.insert(out, {
				Id = "id:" .. sEntry:lower(),
				Label = sEntry,
				SoundId = normalizeSoundAssetId(sEntry),
				SourceType = "id",
				RawValue = sEntry
			})
		end
	end
	return out
end

local function savePosesToFile()
	if not writefile then return end
	
	pcall(function()
		if not isfolder(FOLDER_NAME) then
			makefolder(FOLDER_NAME)
		end
		
		local serializableData = {}
		for folderName, poses in pairs(SavedFolders) do
			serializableData[folderName] = {}
			for poseName, poseData in pairs(poses) do
				serializableData[folderName][poseName] = {
					Joints = {},
					Exclusions = poseData.Exclusions or {},
					IncludedObjects = serializeIncludedObjects(poseData.IncludedObjects or {}),
					Sounds = serializePoseSounds(poseData.Sounds or {}),
					AnimOrder = poseData.AnimOrder,
					Trigger = {
						Enabled = poseData.Trigger and poseData.Trigger.Enabled or false,
						MinHP = poseData.Trigger and poseData.Trigger.MinHP or 0,
						MaxHP = poseData.Trigger and poseData.Trigger.MaxHP or 100
					}
				}
				for jointName, cf in pairs(poseData.Joints) do
					serializableData[folderName][poseName].Joints[jointName] = serializeCFrame(cf)
				end
			end
		end
		
		writefile(FILE_NAME, HttpService:JSONEncode(serializableData))
	end)
end

local function loadPosesFromFile()
	if not readfile or not isfile or not isfile(FILE_NAME) then return end
	
	pcall(function()
		local content = readfile(FILE_NAME)
		local decoded = HttpService:JSONDecode(content)
		if decoded then
			SavedFolders = { ["Default"] = {} }
			for folderName, poses in pairs(decoded) do
				local normFolder = ensureFolderHierarchy(folderName)
				for poseName, poseData in pairs(poses) do
					local savedTrigger = poseData.Trigger or {}
					SavedFolders[normFolder][poseName] = {
						Joints = {},
						Exclusions = poseData.Exclusions or {},
						IncludedObjects = deserializeIncludedObjects(poseData.IncludedObjects),
						Sounds = deserializePoseSounds(poseData.Sounds),
						AnimOrder = nil, -- Clear animation orders on loadup
						Trigger = {
							Enabled = false, 
							MinHP = savedTrigger.MinHP or 0,
							MaxHP = savedTrigger.MaxHP or 100
						}
					}
					local rawJoints = poseData.Joints or poseData
					for jointName, cfTbl in pairs(rawJoints) do
						if jointName ~= "Exclusions" and jointName ~= "Trigger" and jointName ~= "IncludedObjects" and jointName ~= "AnimOrder" and jointName ~= "Sounds" then
							SavedFolders[normFolder][poseName].Joints[jointName] = deserializeCFrame(cfTbl)
						end
					end
				end
			end
		end
	end)
end

