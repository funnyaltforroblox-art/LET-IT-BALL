refreshList = function()
	local prevCanvasPos = scrollList.CanvasPosition

	for _, child in ipairs(scrollList:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end

	for _, folderName in ipairs(getSortedFolderPaths()) do
		local poses = SavedFolders[folderName] or {}
		if not isAnyAncestorCollapsed(folderName) then
			local isCollapsed = CollapsedFolders[folderName] or false
			local depth = getFolderDepth(folderName)
			local indentSpaces = string.rep("   ", depth)
			local leafLabel = getFolderDisplayName(folderName)

			local folderHeaderRow = Instance.new("Frame")
			folderHeaderRow.Size = UDim2.new(1, -8, 0, 25)
			folderHeaderRow.BackgroundColor3 = depth > 0 and Color3.fromRGB(38, 42, 54) or Color3.fromRGB(45, 45, 55)
			folderHeaderRow.Parent = scrollList

			local folderHeader = Instance.new("TextButton")
			folderHeader.Size = UDim2.new(folderName ~= "Default" and 0.72 or 1, 0, 1, 0)
			folderHeader.BackgroundTransparency = 1
			folderHeader.Text = indentSpaces .. (isCollapsed and " ▶ 📁 " or " ▼ 📁 ") .. leafLabel
			folderHeader.TextColor3 = depth > 0 and Color3.fromRGB(160, 220, 255) or Color3.fromRGB(255, 215, 0)
			folderHeader.TextXAlignment = Enum.TextXAlignment.Left
			folderHeader.Font = Enum.Font.SourceSansBold
			folderHeader.TextSize = 13
			folderHeader.TextTruncate = Enum.TextTruncate.AtEnd
			folderHeader.Parent = folderHeaderRow

			folderHeader.MouseButton1Click:Connect(function()
				CollapsedFolders[folderName] = not isCollapsed
				refreshList()
			end)

			local addSubBtn = Instance.new("TextButton")
			addSubBtn.Size = UDim2.new(0.15, 0, 0.8, 0)
			addSubBtn.Position = UDim2.new(folderName ~= "Default" and 0.73 or 0.83, 0, 0.1, 0)
			addSubBtn.BackgroundColor3 = Color3.fromRGB(65, 95, 130)
			addSubBtn.Text = "+Sub"
			addSubBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			addSubBtn.Font = Enum.Font.SourceSansBold
			addSubBtn.TextSize = 11
			addSubBtn.Parent = folderHeaderRow

			local subCorner = Instance.new("UICorner")
			subCorner.CornerRadius = UDim.new(0, 4)
			subCorner.Parent = addSubBtn

			addSubBtn.MouseButton1Click:Connect(function()
				folderInput.Text = folderName .. "/"
				folderInput:CaptureFocus()
			end)

			if folderName ~= "Default" then
				local delFolderBtn = Instance.new("TextButton")
				delFolderBtn.Size = UDim2.new(0.10, 0, 0.8, 0)
				delFolderBtn.Position = UDim2.new(0.89, 0, 0.1, 0)
				delFolderBtn.BackgroundColor3 = Color3.fromRGB(165, 45, 45)
				delFolderBtn.Text = "X"
				delFolderBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				delFolderBtn.Font = Enum.Font.SourceSansBold
				delFolderBtn.TextSize = 11
				delFolderBtn.Parent = folderHeaderRow

				local delFCorner = Instance.new("UICorner")
				delFCorner.CornerRadius = UDim.new(0, 4)
				delFCorner.Parent = delFolderBtn

				delFolderBtn.MouseButton1Click:Connect(function()
					deleteFolderAndSubfolders(folderName)
					savePosesToFile()
					refreshList()
				end)
			end

			if not isCollapsed then
				local sortedPoseNames = {}
				for pName in pairs(poses) do
					table.insert(sortedPoseNames, pName)
				end
				table.sort(sortedPoseNames, function(a, b)
					return a:lower() < b:lower()
				end)

				for _, poseName in ipairs(sortedPoseNames) do
					local poseEntry = poses[poseName]
					local poseIdentifier = folderName .. "/" .. poseName
					local isCurrentlyLoaded = (currentLoadedPoseIdentifier == poseIdentifier)
					local objCount = poseEntry.IncludedObjects and #poseEntry.IncludedObjects or 0

					local poseItem = Instance.new("Frame")
					poseItem.Size = UDim2.new(1, -8, 0, 30)
					poseItem.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
					poseItem.Parent = scrollList

					local nameWidth = animationModeEnabled and 0.29 or 0.40
					local loadX = animationModeEnabled and 0.30 or 0.41
					local loadW = animationModeEnabled and 0.18 or 0.20
					local orderX = 0.49
					local orderW = 0.11
					local settingsX = animationModeEnabled and 0.61 or 0.62
					local settingsW = animationModeEnabled and 0.15 or 0.17
					local exportX = animationModeEnabled and 0.77 or 0.80
					local exportW = animationModeEnabled and 0.21 or 0.18

					local poseNameLabel = Instance.new("TextLabel")
					poseNameLabel.Size = UDim2.new(nameWidth, 0, 1, 0)
					poseNameLabel.BackgroundTransparency = 1
					poseNameLabel.Text = indentSpaces .. "   " .. poseName .. (objCount > 0 and (" [" .. objCount .. " acc]") or "")
					poseNameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
					poseNameLabel.TextXAlignment = Enum.TextXAlignment.Left
					poseNameLabel.Font = Enum.Font.SourceSans
					poseNameLabel.TextSize = 13
					poseNameLabel.TextTruncate = Enum.TextTruncate.AtEnd
					poseNameLabel.Parent = poseItem

					local loadBtn = Instance.new("TextButton")
					loadBtn.Size = UDim2.new(loadW, 0, 0.8, 0)
					loadBtn.Position = UDim2.new(loadX, 0, 0.1, 0)
					loadBtn.BackgroundColor3 = isCurrentlyLoaded and Color3.fromRGB(180, 50, 50) or Color3.fromRGB(0, 120, 215)
					loadBtn.Text = isCurrentlyLoaded and "Unload" or "Load"
					loadBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					loadBtn.Font = Enum.Font.SourceSansBold
					loadBtn.TextSize = 12
					loadBtn.Parent = poseItem

					local btnCorner1 = Instance.new("UICorner")
					btnCorner1.CornerRadius = UDim.new(0, 4)
					btnCorner1.Parent = loadBtn

					loadBtn.MouseButton1Click:Connect(function()
						if LocalPlayer.Character then
							applyPoseData(LocalPlayer.Character, poseEntry, poseIdentifier)
							refreshList()
						end
					end)

					if animationModeEnabled then
						local orderBox = Instance.new("TextBox")
						orderBox.Name = "AnimOrderBox"
						orderBox.Size = UDim2.new(orderW, 0, 0.8, 0)
						orderBox.Position = UDim2.new(orderX, 0, 0.1, 0)
						orderBox.BackgroundColor3 = Color3.fromRGB(50, 45, 70)
						orderBox.Text = poseEntry.AnimOrder and tostring(poseEntry.AnimOrder) or ""
						orderBox.PlaceholderText = "#"
						orderBox.TextColor3 = Color3.fromRGB(255, 240, 150)
						orderBox.Font = Enum.Font.SourceSansBold
						orderBox.TextSize = 12
						orderBox.Parent = poseItem

						local orderCorner = Instance.new("UICorner")
						orderCorner.CornerRadius = UDim.new(0, 4)
						orderCorner.Parent = orderBox

						orderBox.FocusLost:Connect(function()
							local trimmed = string.gsub(orderBox.Text or "", "^%s*(.-)%s*$", "%1")
							local num = tonumber(trimmed)
							if num and num >= 1 then
								poseEntry.AnimOrder = math.floor(num)
								orderBox.Text = tostring(poseEntry.AnimOrder)
							else
								poseEntry.AnimOrder = nil
								orderBox.Text = ""
							end
							savePosesToFile()
							if animationModeEnabled then
								startAnimationSequence()
							end
						end)
					end

					local settingsBtn = Instance.new("TextButton")
					settingsBtn.Size = UDim2.new(settingsW, 0, 0.8, 0)
					settingsBtn.Position = UDim2.new(settingsX, 0, 0.1, 0)
					settingsBtn.BackgroundColor3 = Color3.fromRGB(80, 80, 95)
					settingsBtn.Text = "⚙️"
					settingsBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					settingsBtn.Font = Enum.Font.SourceSansBold
					settingsBtn.TextSize = 12
					settingsBtn.Parent = poseItem

					local btnCorner2 = Instance.new("UICorner")
					btnCorner2.CornerRadius = UDim.new(0, 4)
					btnCorner2.Parent = settingsBtn

					settingsBtn.MouseButton1Click:Connect(function()
						openPoseSettings(folderName, poseName, poseEntry)
					end)

					local exportBtn = Instance.new("TextButton")
					exportBtn.Size = UDim2.new(exportW, 0, 0.8, 0)
					exportBtn.Position = UDim2.new(exportX, 0, 0.1, 0)
					exportBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
					exportBtn.Text = "Export"
					exportBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
					exportBtn.Font = Enum.Font.SourceSansBold
					exportBtn.TextSize = 11
					exportBtn.Parent = poseItem

					local btnCorner3 = Instance.new("UICorner")
					btnCorner3.CornerRadius = UDim.new(0, 4)
					btnCorner3.Parent = exportBtn

					exportBtn.MouseButton1Click:Connect(function()
						local exportString = "\n--- EXPORTED POSE [" .. folderName .. "/" .. poseName .. "] ---\n"
						exportString = exportString .. "local " .. poseName .. " = {\n"
						for joint, cf in pairs(poseEntry.Joints) do
							local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
							exportString = exportString .. string.format('    ["%s"] = CFrame.new(%.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f),\n', joint, x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22)
						end
						exportString = exportString .. "}\n--------------------------"
						
						print(exportString)
						pcall(function()
							setclipboard(exportString)
						end)
					end)
				end
			end
		end
	end

	updateScrollListCanvasSize(false)
	scrollList.CanvasPosition = Vector2.new(0, math.max(0, prevCanvasPos.Y))
end

