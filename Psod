				exportBtn.Position = UDim2.new(0.80, 0, 0.1, 0)
				exportBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
				exportBtn.Text = "Export"
				exportBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
				exportBtn.Font = Enum.Font.SourceSansBold
				exportBtn.TextSize = 11
				exportBtn.Parent = poseItem

				local btnCorner3 = Instance.new("UICorner")
				btnCorner3.CornerRadius = UDim.new(0, 4)
				btnCorner3.Parent = exportBtn

				exportBtn.MouseButton1Click:Connect(function()
					local exportString = "\n--- EXPORTED POSE [" .. folderName .. "/" .. poseName .. "] ---\n"
					exportString = exportString .. "local " .. poseName .. " = {\n"
					for joint, cf in pairs(poseEntry.Joints) do
						local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
						exportString = exportString .. string.format('    ["%s"] = CFrame.new(%.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f),\n', joint, x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22)
					end
					exportString = exportString .. "}\n--------------------------"
					
					print(exportString)
					pcall(function()
						setclipboard(exportString)
					end)
				end)
			end
		end
	end

	scrollList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
