toggleBtn.MouseButton1Click:Connect(function()
	mainFrame.Visible = not mainFrame.Visible
end)

saveBtn.MouseButton1Click:Connect(function()
	local folderName = folderInput.Text ~= "" and folderInput.Text or "Default"
	local poseName = poseInput.Text ~= "" and poseInput.Text or ("Pose_" .. tostring(tick()):sub(5, 8))

	local char = LocalPlayer.Character
	if not char then return end

	local poseData = extractPoseData(char)
	if poseData then
		if not SavedFolders[folderName] then
			SavedFolders[folderName] = {}
		end
		SavedFolders[folderName][poseName] = poseData

		poseInput.Text = ""
		savePosesToFile()
		refreshList()
	end
end)

