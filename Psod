		end
	end

	for folderName, poses in pairs(SavedFolders) do
		local folderHeader = Instance.new("TextLabel")
		folderHeader.Size = UDim2.new(1, -8, 0, 25)
		folderHeader.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
		folderHeader.Text = " 📁 " .. folderName
		folderHeader.TextColor3 = Color3.fromRGB(255, 215, 0)
		folderHeader.TextXAlignment = Enum.TextXAlignment.Left
		folderHeader.Font = Enum.Font.SourceSansBold
		folderHeader.TextSize = 14
		folderHeader.Parent = scrollList

		for poseName, cfData in pairs(poses) do
			local poseItem = Instance.new("Frame")
			poseItem.Size = UDim2.new(1, -8, 0, 30)
			poseItem.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
			poseItem.Parent = scrollList

			local poseNameLabel = Instance.new("TextLabel")
			poseNameLabel.Size = UDim2.new(0.5, 0, 1, 0)
			poseNameLabel.BackgroundTransparency = 1
			poseNameLabel.Text = "   " .. poseName
			poseNameLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
			poseNameLabel.TextXAlignment = Enum.TextXAlignment.Left
			poseNameLabel.Font = Enum.Font.SourceSans
			poseNameLabel.TextSize = 13
			poseNameLabel.Parent = poseItem

			local loadBtn = Instance.new("TextButton")
			loadBtn.Size = UDim2.new(0.22, 0, 0.8, 0)
			loadBtn.Position = UDim2.new(0.52, 0, 0.1, 0)
			loadBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
			loadBtn.Text = "Load"
			loadBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			loadBtn.Font = Enum.Font.SourceSansBold
			loadBtn.TextSize = 12
			loadBtn.Parent = poseItem

			local btnCorner1 = Instance.new("UICorner")
			btnCorner1.CornerRadius = UDim.new(0, 4)
			btnCorner1.Parent = loadBtn

			loadBtn.MouseButton1Click:Connect(function()
				if LocalPlayer.Character then
					applyPoseData(LocalPlayer.Character, cfData)
				end
			end)

			local exportBtn = Instance.new("TextButton")
			exportBtn.Size = UDim2.new(0.22, 0, 0.8, 0)
			exportBtn.Position = UDim2.new(0.76, 0, 0.1, 0)
			exportBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 110)
			exportBtn.Text = "Export"
			exportBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
			exportBtn.Font = Enum.Font.SourceSansBold
			exportBtn.TextSize = 12
			exportBtn.Parent = poseItem

			local btnCorner2 = Instance.new("UICorner")
			btnCorner2.CornerRadius = UDim.new(0, 4)
			btnCorner2.Parent = exportBtn

			exportBtn.MouseButton1Click:Connect(function()
				print("\n--- EXPORTED POSE [" .. folderName .. "/" .. poseName .. "] ---")
				print("local " .. poseName .. " = {")
				for joint, cf in pairs(cfData) do
					local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
					print(string.format('    ["%s"] = CFrame.new(%.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f),', joint, x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22))
				end
				print("}\n--------------------------")
			end)
		end
	end

	scrollList.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
end

